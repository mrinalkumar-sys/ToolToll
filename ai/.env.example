# ToolToll AI Service Configuration
APP_NAME="ToolToll AI Service"
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8001
API_PREFIX=/api/v1

# Inter-Service Authentication (Shared secret with main ToolToll backend)
INTERNAL_SERVICE_KEY=tooltoll-internal-secret-service-key-2026

# LLM Provider ('groq' or 'anthropic')
LLM_PROVIDER=groq

# Groq API Configuration (Obtain your key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_placeholder_put_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# Optional: Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-haiku-20240307

# ToolToll Main Backend Gateway & Marketplace URL
BACKEND_BASE_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=20.0
GATEWAY_MAX_RETRIES=2

# Security & SSRF Configuration
ALLOW_PRIVATE_IPS_FOR_TESTS=false

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:8000"]
