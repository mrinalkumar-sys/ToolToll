# ToolToll Environment Variables Configuration
APP_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Database
DATABASE_URL=postgresql://tooltoll:tooltoll@localhost:5432/tooltoll_db?schema=public

# Authentication & Encryption
# 32+ characters secret for JWT
AUTH_SECRET_KEY=super-secret-jwt-signing-key-tooltoll-mvp-32chars-min
# 32-byte hex or base64 key for AES-256-GCM (64 hex characters = 32 bytes)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# AI Adapter (mock, openai, anthropic)
LLM_PROVIDER=mock
LLM_API_KEY=mock-api-key

# Payments & PayPal (mock or paypal)
PAYMENT_ADAPTER=mock
PAYOUT_ADAPTER=mock
PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=mock_webhook_id

# System Constraints & Fees
PLATFORM_FEE_BPS=1000
TOOL_EXECUTION_TIMEOUT_MS=15000
MAX_REQUEST_SIZE=1048576
