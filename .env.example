# ==========================================
# ToolToll Production / Development Settings
# ==========================================

# Application
APP_NAME=ToolToll
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
# For SQLite local development:
DATABASE_URL=sqlite+aiosqlite:///./tooltoll.db
# For PostgreSQL (Docker or Managed Cloud):
# DATABASE_URL=postgresql+asyncpg://tooltoll_user:tooltoll_secret_pass@localhost:5432/tooltoll

# Authentication
# Generate a strong 32+ character random secret for production
AUTH_SECRET_KEY=tooltoll-super-secure-jwt-signing-secret-key-32-chars-min
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Credential Encryption (Fernet 32-byte urlsafe base64 key)
AGENT_CREDENTIAL_ENCRYPTION_KEY=Dq0qDk8e0b6w0rZ3A1r1mE8lV2gT4yU6iO8pA0sD2fG=

# Platform Business Rules
PLATFORM_FEE_PERCENT=0.15
DEFAULT_CURRENCY=USD

# PayPal Sandbox Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# AI & LLM Provider Configuration ('mock', 'openai', 'anthropic', 'gemini')
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Tool Execution & Security Limits
TOOL_EXECUTION_TIMEOUT=15
MAX_REQUEST_SIZE_BYTES=1000000
ALLOW_PRIVATE_IPS_FOR_TESTS=false
