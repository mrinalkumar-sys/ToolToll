# ==========================================
# ToolToll Frontend Environment Variables
# ==========================================

# Target URL for backend API proxy (Vite dev server proxies /api -> BACKEND_URL)
# - For local host development: http://localhost:4000
# - For Docker Compose network: http://backend:4000
BACKEND_URL=http://localhost:4000

# Target URL for AI service proxy (Vite dev server proxies /ai-api -> AI_SERVICE_URL)
# - For local host development: http://127.0.0.1:8001
# - For Docker Compose network: http://ai-service:8001
AI_SERVICE_URL=http://127.0.0.1:8001

# Vite Client Variables (Accessible in browser client code via import.meta.env)
VITE_APP_TITLE=ToolToll
VITE_APP_NAME=ToolToll
VITE_APP_DESCRIPTION="The AI Tool Marketplace - Pay only for what you use"

# API Base Paths (Handled by Vite's internal reverse proxy)
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai-api

